{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "H3 DiT ref2va — the OTHER checkpoint, +20.97 GB" },
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": { "model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0 }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "14": {
    "class_type": "LoadImage",
    "_meta": { "title": "reference image — character/style to carry into the clip" },
    "inputs": { "image": "example.png" }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": {
      "title": "ref2va — ref_images is an autogrow list, prefix ref_image_N (max 9)"
    },
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "audio_vae": ["5", 0],
      "prompt": "The referenced subject walks through a sunlit courtyard, footsteps and birdsong.",
      "width": 1344,
      "height": 768,
      "length": 124,
      "ref_image_size": "match",
      "ref_image_0": ["14", 0]
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["6", 0] }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["6", 1],
      "denoise": 1.0
    }
  },
  "9": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["8", 0] } },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": ["9", 0], "vae": ["4", 0] } },
  "11": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["9", 1], "audio_vae": ["5", 0] } },
  "12": { "class_type": "CreateVideo", "inputs": { "images": ["10", 0], "fps": 24.0, "audio": ["11", 0] } },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "video/MiniMaxH3-r2v",
      "format": "auto",
      "codec": "auto"
    }
  }
}
