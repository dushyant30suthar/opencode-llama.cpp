{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "H3 DiT (pruned int8, 20.97 GB)" },
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": { "title": "Sigma shift (node defaults — model's own values)" },
    "inputs": {
      "model": ["1", 0],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL-32B NVFP4 (native on sm_120)" },
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": { "title": "Video VAE" },
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "5": {
    "class_type": "VAELoader",
    "_meta": { "title": "Audio VAE" },
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": { "title": "t2va — no keyframes means pure text-to-video" },
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "prompt": "A slow dolly shot through a rain-soaked Tokyo alley at night, neon signs reflecting in puddles, steam rising from a ramen stall, distant traffic and rain on metal awnings.",
      "width": 1344,
      "height": 768,
      "length": 124
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "negative — the H3 nodes only emit positive" },
    "inputs": { "conditioning": ["6", 0] }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "steps/cfg are starting points, not published values" },
    "inputs": {
      "model": ["2", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["6", 1],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "LTXVSeparateAVLatent",
    "_meta": { "title": "split the NestedTensor(video, audio) pack" },
    "inputs": { "av_latent": ["8", 0] }
  },
  "10": {
    "class_type": "VAEDecode",
    "_meta": { "title": "video stream" },
    "inputs": { "samples": ["9", 0], "vae": ["4", 0] }
  },
  "11": {
    "class_type": "LTXVAudioVAEDecode",
    "_meta": { "title": "audio stream" },
    "inputs": { "samples": ["9", 1], "audio_vae": ["5", 0] }
  },
  "12": {
    "class_type": "CreateVideo",
    "_meta": { "title": "24 fps — H3's native rate" },
    "inputs": { "images": ["10", 0], "fps": 24.0, "audio": ["11", 0] }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "video/MiniMaxH3-t2v",
      "format": "auto",
      "codec": "auto"
    }
  }
}
