{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "H3 DiT — 20.97 GB against 15.5 GiB, so some spills to RAM" },
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "15": {
    "class_type": "SelectModelDevice",
    "_meta": { "title": "DiT pinned to gpu:0 — it owns this card for the whole sampling loop" },
    "inputs": { "model": ["1", 0], "device": "gpu:0" }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": { "model": ["15", 0], "shift_video": 12.0, "shift_audio": 3.0 }
  },
  "3": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL-32B NVFP4, 15.69 GB" },
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "16": {
    "class_type": "SelectCLIPDevice",
    "_meta": { "title": "encoder to gpu:1 — runs once, then ComfyUI can evict it" },
    "inputs": { "clip": ["3", 0], "device": "gpu:1" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "17": {
    "class_type": "SelectVAEDevice",
    "_meta": { "title": "video VAE to gpu:1 — decode runs after sampling ends" },
    "inputs": { "vae": ["4", 0], "device": "gpu:1" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "18": {
    "class_type": "SelectVAEDevice",
    "inputs": { "vae": ["5", 0], "device": "gpu:1" }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["16", 0],
      "vae": ["17", 0],
      "prompt": "A slow dolly shot through a rain-soaked Tokyo alley at night, neon signs reflecting in puddles, steam rising from a ramen stall, distant traffic and rain on metal awnings.",
      "width": 1344,
      "height": 768,
      "length": 124
    }
  },
  "7": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["6", 0] } },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["6", 1],
      "denoise": 1.0
    }
  },
  "9": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["8", 0] } },
  "10": { "class_type": "VAEDecode", "inputs": { "samples": ["9", 0], "vae": ["17", 0] } },
  "11": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["9", 1], "audio_vae": ["18", 0] } },
  "12": { "class_type": "CreateVideo", "inputs": { "images": ["10", 0], "fps": 24.0, "audio": ["11", 0] } },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "video/MiniMaxH3-t2v-dualgpu",
      "format": "auto",
      "codec": "auto"
    }
  }
}
