version = 1

# Per-model settings — YOURS TO EDIT. New models get a default section appended;
# existing sections are never modified or removed by opencode.
# Any llama-server flag works as a key (without leading dashes). Common ones:
#   ctx-size = 32768          context window tokens
#   gpu-layers = 99           layers offloaded to GPU (99 = all)
#   tensor-split = 0.67,0.33  VRAM ratio across the two GPUs
#   cache-type-k = q8_0       KV cache quant: f16 | q8_0 | q4_0
#   cache-type-v = q8_0
#   flash-attn = on
#   temp = 0.7                sampling temperature
#   reasoning-preserve = true keep <think> blocks in multi-turn history (thinking
#                             models loop/repeat tool calls without it; template
#                             support auto-detected, see router.log)
# QWEN3.6 THINKING SAMPLERS (official "precise coding" card values):
#   temp = 0.6, top-p = 0.95, top-k = 20, min-p = 0
# CHAT PROFILE (max generation speed, 152 t/s on the 35B; prompt speed -30%):
#   split-mode = tensor, ubatch-size = 2048
# SPEED PROFILE (alternative to max-context): for snappier agent turns use
#   ctx-size = 65536, cache-type-k/v = f16, spec-type = ngram-mod
# (draft-free speculative decoding conflicts with quantized KV cache).
# Changes apply on next model load (restart the router or swap models).


# ----------------------------------------------------------------------------
# Recovered 2026-07-26 after the live models.ini was deleted.
#   sections 1-3  verbatim from config/models.ini.example (opencode-llama.cpp)
#   sections 4-7  verbatim from the Laguna tuning session transcript
# Every value here was read back from a source, not reconstructed.
# ----------------------------------------------------------------------------
[lmstudio-community/gemma-4-31B-it-QAT-GGUF]
model = ~/.lmstudio/models/lmstudio-community/gemma-4-31B-it-QAT-GGUF/gemma-4-31B-it-QAT-Q4_0.gguf
mmproj = ~/.lmstudio/models/lmstudio-community/gemma-4-31B-it-QAT-GGUF/mmproj-gemma-4-31B-it-QAT-BF16.gguf
ctx-size = 147456
gpu-layers = 99
flash-attn = on
cache-type-k = q8_0
cache-type-v = q8_0
jinja = true
split-mode = tensor
# host prompt-cache cap: default 8GiB+ swamped the 32GB box (24GB swapped)
cache-ram = 2048
[lmstudio-community/Qwen3.6-35B-A3B-GGUF]
model = ~/.lmstudio/models/lmstudio-community/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-Q4_K_M.gguf
mmproj = ~/.lmstudio/models/lmstudio-community/Qwen3.6-35B-A3B-GGUF/mmproj-Qwen3.6-35B-A3B-BF16.gguf
ctx-size = 245760
ubatch-size = 2048
gpu-layers = 99
flash-attn = on
cache-type-k = q8_0
cache-type-v = q8_0
jinja = true
split-mode = tensor
# host prompt-cache cap: default 8GiB+ swamped the 32GB box (24GB swapped)
# host prompt-cache DISABLED: cap does not hold on hybrid arch (2048 cap
# → 26.8GB swapped, 2026-07-10; restore is inert on hybrids anyway)
cache-ram = 0
# keep thinking in history — prevents tool-call loops, keeps KV prefix cache hot
reasoning-preserve = true
# official Qwen3.6 thinking "precise coding" samplers
temp = 0.6
top-p = 0.95
top-k = 20
min-p = 0
[michaelw9999/Qwen3.6-27B-NVFP4-MTP-GGUF]
model = ~/.lmstudio/models/michaelw9999/Qwen3.6-27B-NVFP4-MTP-GGUF/Qwen3.6-27B-NVFP4-MTP-GGUF.gguf
# 192k: sweet spot below probed max 212992 — 208896 left ~0.3G VRAM free, 196608 keeps ~0.9G
# on the tighter GPU (15.4/16.3 measured). q8_0 KV ≈ 0.18GB per 4096 tokens here.
ctx-size = 196608
gpu-layers = 99
flash-attn = on
cache-type-k = q8_0
cache-type-v = q8_0
jinja = true
split-mode = tensor
ubatch-size = 2048
parallel = 1
spec-type = draft-mtp
# n-max 3 = measured peak for NVFP4 (76.3 t/s vs 73.2 @ n4, 69.0 @ n5 — 2026-07-10 bench)
spec-draft-n-max = 3
# host prompt-cache DISABLED: cap does not hold on hybrid arch
cache-ram = 0
reasoning-preserve = true
# official Qwen3.6 thinking "precise coding" samplers
temp = 0.6
top-p = 0.95
top-k = 20
min-p = 0

[poolside/Laguna-XS-2.1-GGUF]
# fast tier. Q4_K_M, 19.3GiB, fits entirely in VRAM.
# measured: 4070 t/s prefill, 146 t/s decode (102 @20k ctx)
# NOTE f16 KV here, not q8_0 — draft-free speculative decoding (ngram-mod)
# conflicts with a quantized KV cache.
model = /home/dushyant30suthar/.lmstudio/models/poolside/Laguna-XS-2.1-GGUF/Laguna-XS-2.1-Q4_K_M.gguf
split-mode = layer
ctx-size = 98304
gpu-layers = 99
flash-attn = on
cache-type-k = f16
cache-type-v = f16
jinja = true
ubatch-size = 2048
spec-type = ngram-mod
cache-ram = 0
reasoning-preserve = true
temp = 1.0
top-k = 20
top-p = 1.0
min-p = 0

[unsloth/Laguna-S-2.1-GGUF]
# smart/verifier tier. UD-Q2_K_XL, 36.96GiB, expert-offload.
# measured: 548 t/s prefill, 16.7 t/s decode, 30.6G VRAM, 6/6 on the bug suite.
# do NOT "upgrade" to UD-IQ3_XXS or UD-IQ3_S — equal detection, bigger, slower.
# override-tensor below keeps 30 of 48 expert layers on GPU ("K=15").
# K13 = 15.68 t/s, K15 = 16.68, K17 = OOM. Re-run the ladder if the quant changes.
# split-mode tensor/row ABORTS on laguna: "device does not support split buffers"
model = /home/dushyant30suthar/.lmstudio/models/unsloth/Laguna-S-2.1-GGUF/Laguna-S-2.1-UD-Q2_K_XL.gguf
override-tensor = blk\.(0|1|2|3|4|5|6|7|8|24|25|26|27|28|29|30|31|32)\.ffn_.*_exps\.=CPU
split-mode = layer
ctx-size = 98304
gpu-layers = 99
flash-attn = on
cache-type-k = q8_0
cache-type-v = q8_0
jinja = true
ubatch-size = 2048
no-mmap = true
cache-ram = 0
reasoning-preserve = true
temp = 1.0
top-k = 20
top-p = 1.0
min-p = 0

[unsloth/Devstral-Small-2-24B-Instruct-2512-GGUF]
# verifier/cross-checker: different lab (Mistral), dense 24B, 256K native
model = /home/dushyant30suthar/.lmstudio/models/unsloth/Devstral-Small-2-24B-Instruct-2512-GGUF/Devstral-Small-2-24B-Instruct-2512-UD-Q4_K_XL.gguf
ctx-size = 131072
gpu-layers = 99
flash-attn = on
cache-type-k = q8_0
cache-type-v = q8_0
jinja = true
split-mode = layer
# Mistral-recommended sampler for Devstral
temp = 0.15

[unsloth/MiniMax-M2.5-GGUF]
# 230B-A10B MoE, 74GB: experts stay in RAM/NVMe (mmap), attention on GPU.
# ~2-4 t/s is expected here, not a fault.
model = /home/dushyant30suthar/.lmstudio/models/unsloth/MiniMax-M2.5-GGUF/MiniMax-M2.5-UD-IQ2_XXS-00001-of-00003.gguf
cpu-moe = true
ctx-size = 32768
gpu-layers = 99
flash-attn = on
cache-type-k = q8_0
cache-type-v = q8_0
jinja = true
